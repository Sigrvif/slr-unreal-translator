# Build outputs and fetched payloads (rebuilt by build/build_release.py
# and build/fetch_*.py — never committed)
dist/
runtime/

# Dev-era snapshots and analysis state (kept on disk, not source)
_snapshots/
.sdd/

# Local caches and secrets (AES game keys are discovered per machine
# and cached locally — they must never be committed or shipped)
__pycache__/
.pytest_cache/
backend/keys.json

# test-run artifacts (regenerated by game-gated tests, never committed)
backend/backend.log
backend/tests/fixtures/_slr_discover_manifest.json
backend/tests/fixtures/_slr_discover_result.json
backend/tests/fixtures/backend.log
backend/tests/fixtures/local/
